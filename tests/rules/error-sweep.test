# * Differences from the reference hledger found by the error sweep of
# 2026-11-09, each now as the reference has it (expectations from the
# reference hledger; fixtures in import/).

# ** 1. A failing --alias on CSV data shows the aliases as upstream's pshow
# lays them out, in the order given.
$ hledger -f import/bank.csv --alias b=c --alias '/a/=\2' print
>2
hledger: Error: problem while applying account aliases:
[ BasicAlias "b" "c"
, RegexAlias
  ( RegexpCI "a" ) "\2"
]
 to account name: assets:bank
 no match group exists for backreference "\2"
>=1

# ** 2. On timedot data too.
<
2024-01-01
proj:a  1

$ hledger -f timedot:- --alias '/a/=\2' print
>2
hledger: Error: problem while applying account aliases:
[ RegexAlias
  ( RegexpCI "a" ) "\2"
]
 to account name: proj:a
 no match group exists for backreference "\2"
>=1

# ** 3. On timeclock data too, coloured as there when colour is on.
<
i 2024-01-01 09:00:00 proj:a
o 2024-01-01 10:30:00

$ hledger -f timeclock:- --alias '/a/=\2' --alias '/x/=' print --color=always
>2
[91m[1mhledger: Error: problem while applying account aliases:[39m[49m[22m
[0;95;1m[[0m RegexAlias
  [0;96;1m([0m RegexpCI [0;97;1m"[0m[0;94;1ma[0m[0;97;1m"[0m [0;96;1m)[0m [0;97;1m"[0m[0;94;1m\2[0m[0;97;1m"[0m
[0;95;1m,[0m RegexAlias
  [0;96;1m([0m RegexpCI [0;97;1m"[0m[0;94;1mx[0m[0;97;1m"[0m [0;96;1m)[0m [0;97;1m"[0m[0;94;1m[0m[0;97;1m"[0m
[0;95;1m][0m
 to account name: proj:a
 no match group exists for backreference "\2"
>=1

# ** 4. setup names the basic account types found, or missing, by their
# letters (with no network: the proxy refuses).
$ D=$(mktemp -d) && printf 'account assets\naccount liabilities\naccount equity\naccount revenues\naccount expenses\naccount assets:cash\n' >$D/a.j && LEDGER_FILE=$D/a.j HTTPS_PROXY=http://127.0.0.1:9 hledger setup | grep 'basic types'; printf 'account assets\n' >$D/a.j && LEDGER_FILE=$D/a.j HTTPS_PROXY=http://127.0.0.1:9 hledger setup | grep 'basic types'; rm -rf $D
  accounts of all basic types exist ?      yes  ALERXC accounts detected
  accounts of all basic types exist ?       no  bs/is/cf need LERXC accounts

# ** 5. A relative $LEDGER_FILE is used, and shown, as ./FILE, a glob's
# match too (upstream expands it against ".").
$ LEDGER_FILE=import/a.j hledger files
./import/a.j

# ** 6.
$ LEDGER_FILE='import/[a]*.j' hledger files
./import/a.j

# ** 7.
$ LEDGER_FILE=import/nosuch.j hledger print
>2
hledger: Error: data file "./import/nosuch.j" was not found.
Please create it first, eg with "hledger add" or a text editor.
Or, specify an existing data file with -f or $LEDGER_FILE.
>=1

# ** 8. A report interval of the 0th weekday of each month (the week before
# the first) gives a period per month, the first boundary computed twice
# but used once.
<
2024-01-01 x
    a   1
    b

2024-03-15 y
    a   2
    b

$ hledger -f - bal -p 'every 0th mon' -N
Balance changes in 2023-11-27..2024-03-24:

   || 2023-11-27..2023-12-24  2023-12-25..2024-01-28  2024-01-29..2024-02-25  2024-02-26..2024-03-24 
===++================================================================================================
 a ||                      0                       1                       0                       2 
 b ||                      0                      -1                       0                      -2 

# ** 9. A config file that is not UTF-8 is an error, without the advice
# given for other files (fixtures in error-sweep/).
$ D=$(mktemp -d) && cp error-sweep/latin1.txt $D/c.conf && hledger --conf $D/c.conf -f import/a.j print 2>&1 | sed "s|$D|D|"; rm -rf $D
hledger: Error: D/c.conf: hGetContents: invalid argument (cannot decode byte sequence starting from 233)
(hledger 1.99 could not read this config file. To run without it, add -n.)

# ** 10. A --alias that does not parse: the error expects what upstream's
# alternatives would have taken there: an expression not closed, an empty
# one, a backslash at the end, no name before =.
$ hledger -f import/a.j --alias '/x' print
>2
hledger: Error: --alias:1:3:
  |
1 | /x
  |   ^
unexpected end of input
expecting "\/", '/', or '\'
>=1

$ hledger -f import/a.j --alias '//=x' print
>2
hledger: Error: --alias:1:2:
  |
1 | //=x
  |  ^^
unexpected "/="
expecting "\/" or '\'
>=1

$ hledger -f import/a.j --alias '/x\' print
>2
hledger: Error: --alias:1:4:
  |
1 | /x\
  |    ^
unexpected end of input
>=1

$ hledger -f import/a.j --alias '=x' print
>2
hledger: Error: --alias:1:1:
  |
1 | =x
  | ^
unexpected '='
expecting '/'
>=1

# ** 14. An unknown check name is an error of the argument parse: shown
# with the final command line, and before an unknown flag after it.
$ hledger -f import/a.j check nosuch --nosuchflag
>2
hledger: Error: Unhandled argument, unknown check name: nosuch
* while parsing the following args, final command line:
*  check -f import/a.j nosuch --nosuchflag
>=1

# ** 15. In run too, as a usage error.
$ hledger -f import/a.j run -- check nosuch
>2
hledger: Error: Unhandled argument, unknown check name: nosuch (use -h to see usage)
>=1

# ** 16. -o to a file that can not be written: GHC's words for the error.
$ hledger -f import/a.j print -o /nonexistent/x
>2
hledger: Error: /nonexistent/x: withFile: does not exist (No such file or directory)
>=1

# ** 17. A directory, as GHC says it when writing.
$ D=$(mktemp -d) && hledger -f import/a.j print -o $D 2>&1 | sed "s|$D|D|"; rm -rf $D
hledger: Error: D: withFile: inappropriate type (Is a directory)

# ** 18. rewrite --add-posting with no account name: the error is where the
# name should start, as the account name parser gives it.
$ hledger -f import/a.j rewrite --add-posting '  '
>2
hledger: Error: 1:4:
  |
1 |    
  |    ^
unexpected newline
>=1

# ** 19. rewrite shows an --add-posting's error where it was raised, not
# where its region starts as other errors are shown (it does without
# hledger's customErrorBundlePretty): an invalid date after the date, the
# caret line as long as the date but cut at the end of the line; an
# expression's error after the expression.
$ hledger -f import/a.j rewrite --add-posting 'x  1 ; date:2024-13-01'
>2
hledger: Error: 1:24:
  |
1 |  x  1 ; date:2024-13-01
  |                        ^

This is not a valid date, please fix it.
>=1

$ hledger -f import/a.j rewrite --add-posting 'x  (1 / (2 - 2))'
>2
hledger: Error: 1:17:
  |
1 |  x  (1 / (2 - 2))
  |                 ^^

can't divide by zero
>=1

$ hledger -f import/a.j rewrite --add-posting 'x  10 EUR/4'
>2
hledger: Error: 1:12:
  |
1 |  x  10 EUR/4
  |            ^

this / is read as part of the commodity symbol EUR/; to divide, write a space before it (eg 10 EUR / 4)
>=1

# ** 22. CSV text that its declared encoding can not decode raises the
# encoding package's exception, which upstream catches nowhere: GHC's
# runtime shows it after the program name, without "Error:", then two
# empty lines; a code beyond U+10FFFF shows its bytes as a Haskell list.
$ hledger -f error-sweep/illegal.csv print
>2
hledger: IllegalCharacter 255


>=1

$ hledger -f error-sweep/outofrange.csv print
>2
hledger: IllegalRepresentation [244,144,128,128]


>=1

# ** 24. Nothing wraps it, not even the include that read the file.
<
include error-sweep/illegal.csv

$ hledger -f - print
>2
hledger: IllegalCharacter 255


>=1

