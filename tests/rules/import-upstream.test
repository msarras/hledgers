# ** 7. With --strict, the journal with the new transactions is checked first (the last new one
# first), and nothing is imported if that fails.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cp import/strict.j $D && cd $D && hledger -f strict.j import --strict bank.csv 2>e; s=$?; sed "s|$D|D|" e; test -e .latest.bank.csv || echo no latest; printf 'account expenses:misc\n' >>strict.j; hledger -f strict.j import --strict bank.csv 2>e; s=$?; sed "s|$D|D|" e; cat strict.j; cd /; rm -rf $D; exit $s
