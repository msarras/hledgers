# ** 2. A row dated before the latest date (backfilled) is not imported.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cd $D && hledger -f a.j import bank.csv 2>e; s=$?; sed "s|$D|D|" e; printf '2020-01-01,refund,-3\n' >>bank.csv; hledger -f a.j import bank.csv 2>e; s=$?; sed "s|$D|D|" e; cat .latest.bank.csv; cd /; rm -rf $D; exit $s
