# ** 5. With nothing new since the latest dates, nothing is imported, and the .latest file is kept.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cd $D && hledger -f a.j import bank.csv 2>e; s=$?; sed "s|$D|D|" e; hledger -f a.j import bank.csv 2>e; s=$?; sed "s|$D|D|" e; cat .latest.bank.csv; cd /; rm -rf $D; exit $s
