# ** 3. --catchup marks the transactions as imported without importing them;
# with --dry-run it says how many it would skip, and writes nothing.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cd $D && hledger -f a.j import --catchup --dry-run bank.csv 2>e; s=$?; sed "s|$D|D|" e; test -e .latest.bank.csv || echo no latest; hledger -f a.j import --catchup bank.csv 2>e; s=$?; sed "s|$D|D|" e; cat .latest.bank.csv; printf '2020-01-04,gift,20\n' >>bank.csv; hledger -f a.j import bank.csv 2>e; s=$?; sed "s|$D|D|" e; cat a.j; cd /; rm -rf $D; exit $s
