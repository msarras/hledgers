# ** 4. Several files are imported together, named in the message, each with its own .latest file.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cp import/card.csv $D && cp import/card.csv.rules $D && cd $D && hledger -f a.j import bank.csv card.csv 2>e; s=$?; sed "s|$D|D|" e; cat .latest.bank.csv .latest.card.csv; cat a.j; cd /; rm -rf $D; exit $s
imported 4 new transactions from bank.csv, card.csv to D/a.j
