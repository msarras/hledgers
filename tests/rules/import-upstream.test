# ** 6. print --new shows only the transactions added since the last print --new, and updates .latest.
$ D=$(mktemp -d) && cp import/a.j $D && cp import/bank.csv $D && cp import/bank.csv.rules $D && cd $D && hledger -f bank.csv print --new; s=$?; hledger -f bank.csv print --new; printf '2020-01-03,rent,500\n' >>bank.csv; hledger -f bank.csv print --new; cat .latest.bank.csv; cd /; rm -rf $D; exit $s
